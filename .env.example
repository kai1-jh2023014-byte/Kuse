# auto uses OpenAI when OPENAI_API_KEY is set, otherwise on-device measurement.
# heuristic forces on-device analysis. openai requires a key.
AI_PROVIDER=auto

# Optional. Any OpenAI-compatible chat completions endpoint that accepts images.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional. KUSE can register an MCP OAuth client without these.
# Developer Portal OC- IDs currently make mcp.canva.com/authorize return 500.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://127.0.0.1:3847/api/canva/callback
