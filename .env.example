# auto uses OpenAI when OPENAI_API_KEY is set, otherwise on-device measurement.
# heuristic forces on-device analysis. openai requires a key.
AI_PROVIDER=auto

# Optional. Any OpenAI-compatible chat completions endpoint that accepts images.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Canva MCP. Developer Portal → Outside Canva → turn on Canva MCP.
# Authorization server: https://mcp.canva.com
# Tokens stay on the server. Do not put them in the browser.
# Self-service MCP enablement may still be waitlisted. See the access docs.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Must match a redirect URL registered in the Developer Portal, exactly.
CANVA_REDIRECT_URI=http://127.0.0.1:3847/api/canva/callback
