# auto uses OpenAI when OPENAI_API_KEY is set, otherwise on-device measurement.
# heuristic forces on-device analysis. openai requires a key.
AI_PROVIDER=auto

# Optional. Any OpenAI-compatible chat completions endpoint that accepts images.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Canva MCP. Authorization server: https://mcp.canva.com
# Developer Portal client IDs start with OC-. Those currently make
# mcp.canva.com/authorize return Internal Server Error, so KUSE registers
# a dedicated MCP client via POST https://mcp.canva.com/register on first connect.
# Tokens stay on the server. Do not put them in the browser.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://127.0.0.1:3847/api/canva/callback
